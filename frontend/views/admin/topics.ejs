<%- include('../partials/head', { judul: judul }) %>
<%- include('../partials/navbar') %>

  <main class="flex-1 w-full max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-brand-50 text-brand-700 text-xs font-semibold mb-2">
          <iconify-icon icon="lucide:shield-check" width="14" height="14"></iconify-icon>
          <span>Area Admin</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Kelola Katalog Topik</h1>
        <p class="text-sm text-slate-600 mt-1">Topik di sini tampil di katalog mahasiswa dan menjadi sumber context AI Tutor.</p>
      </div>
      <a href="/admin/topics/create" class="self-start sm:self-auto px-4 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm shadow-sm transition flex items-center gap-1.5">
        <iconify-icon icon="lucide:plus" width="16" height="16"></iconify-icon>
        <span>Tambah Topik</span>
      </a>
    </div>

    <%- include('../partials/alert') %>

    <% if (dbError) { %>
      <div class="mb-6 p-4 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-sm flex gap-2">
        <iconify-icon icon="lucide:alert-triangle" width="18" height="18" class="mt-0.5 shrink-0 text-amber-600"></iconify-icon>
        <span><%= dbError %></span>
      </div>
    <% } %>

    <% if (topics.length) { %>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-5 py-3 border-b border-slate-100 text-xs font-semibold text-slate-500">
          <%= topics.length %> topik di katalog
        </div>
        <ul class="divide-y divide-slate-100">
          <% topics.forEach(function(t) { const lv = Array.isArray(t.levels) ? t.levels : []; %>
            <li class="px-4 sm:px-5 py-4 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 hover:bg-slate-50/60 transition">
              <div class="flex items-start gap-3 min-w-0 flex-1">
                <span class="h-10 w-10 shrink-0 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center">
                  <iconify-icon icon="<%= t.icon || 'lucide:book-open' %>" width="20" height="20"></iconify-icon>
                </span>
                <div class="min-w-0">
                  <p class="font-bold text-slate-900 text-sm truncate"><%= t.nama %></p>
                  <p class="text-xs text-slate-500 line-clamp-1"><%= t.deskripsi %></p>
                  <div class="mt-1.5 flex flex-wrap items-center gap-1.5 text-[11px]">
                    <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 font-semibold"><%= t.kategori %></span>
                    <% lv.forEach(function(l) { %>
                      <span class="px-2 py-0.5 rounded-full bg-brand-50 text-brand-700"><%= l %></span>
                    <% }); %>
                    <span class="text-slate-400">Diperbarui <%= formatTanggal(t.updatedAt) %></span>
                  </div>
                </div>
              </div>
              <div class="flex items-center gap-2 shrink-0 sm:ml-auto">
                <a href="/admin/topics/<%= t.id %>/edit" class="px-3 py-2 rounded-lg border border-slate-200 bg-white hover:border-brand-300 hover:bg-brand-50 text-slate-700 hover:text-brand-800 text-xs font-semibold transition flex items-center gap-1.5">
                  <iconify-icon icon="lucide:edit-3" width="14" height="14"></iconify-icon>
                  <span>Edit</span>
                </a>
                <form action="/admin/topics/<%= t.id %>/delete" method="POST" data-confirm="Topik &quot;<%= t.nama %>&quot; akan dihapus permanen dari katalog." data-confirm-title="Hapus topik ini?" data-confirm-text="Hapus Topik" data-confirm-variant="danger">
                  <button type="submit" class="px-3 py-2 rounded-lg border border-slate-200 bg-white hover:border-rose-200 hover:bg-rose-50 text-slate-600 hover:text-rose-600 text-xs font-semibold transition flex items-center gap-1.5">
                    <iconify-icon icon="lucide:trash-2" width="14" height="14"></iconify-icon>
                    <span>Hapus</span>
                  </button>
                </form>
              </div>
            </li>
          <% }); %>
        </ul>
      </div>
    <% } else if (!dbError) { %>
      <div class="py-16 text-center bg-white rounded-3xl border border-dashed border-slate-300 px-6">
        <div class="h-14 w-14 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3">
          <iconify-icon icon="lucide:book-open" width="28" height="28"></iconify-icon>
        </div>
        <h2 class="text-base font-bold text-slate-800">Katalog masih kosong</h2>
        <p class="text-xs text-slate-500 mt-1">Tambahkan topik pertama agar mahasiswa bisa mulai belajar.</p>
        <a href="/admin/topics/create" class="inline-flex items-center gap-1.5 mt-5 px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs shadow-sm transition">
          <iconify-icon icon="lucide:plus" width="14" height="14"></iconify-icon>
          <span>Tambah Topik Pertama</span>
        </a>
      </div>
    <% } %>
  </main>

<%- include('../partials/confirm-modal') %>
<%- include('../partials/footer') %>
