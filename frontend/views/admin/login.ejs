<%- include('../partials/head', { judul: judul }) %>
<%- include('../partials/navbar') %>

  <main class="flex-1 w-full flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-sm">
      <div class="bg-white rounded-3xl border border-slate-200 shadow-xl shadow-slate-900/5 p-7">
        <div class="flex flex-col items-center text-center mb-6">
          <div class="h-14 w-14 rounded-2xl bg-brand-50 text-brand-700 flex items-center justify-center mb-3">
            <iconify-icon icon="lucide:shield-check" width="28" height="28"></iconify-icon>
          </div>
          <h1 class="text-xl font-extrabold text-slate-900">Masuk Admin</h1>
          <p class="text-xs text-slate-500 mt-1 leading-relaxed">Khusus pengelola katalog topik (tim pengembang / dosen pengampu).</p>
        </div>

        <% if (!configured) { %>
          <div class="mb-5 p-3.5 rounded-xl bg-amber-50 border border-amber-200 text-amber-900 text-xs leading-relaxed flex gap-2">
            <iconify-icon icon="lucide:alert-triangle" width="15" height="15" class="mt-0.5 shrink-0 text-amber-600"></iconify-icon>
            <span>Area admin belum dikonfigurasi. Hubungi pengelola aplikasi.</span>
          </div>
        <% } %>

        <% if (error) { %>
          <div class="mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-xs flex gap-2" role="alert">
            <iconify-icon icon="lucide:alert-circle" width="15" height="15" class="mt-px shrink-0"></iconify-icon>
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/admin/login" method="POST" class="space-y-4">
          <input type="hidden" name="next" value="<%= next %>">
          <div>
            <label for="password" class="block text-xs font-semibold text-slate-700 mb-1.5">Kata Sandi Admin</label>
            <div class="relative">
              <input
                type="password"
                id="password"
                name="password"
                required
                autofocus
                autocomplete="current-password"
                <%= configured ? '' : 'disabled' %>
                class="w-full rounded-xl border border-slate-200 bg-slate-50/70 pl-3.5 pr-11 py-2.5 text-sm text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-500/20 focus:border-brand-500 disabled:opacity-60 transition"
              >
              <button type="button" id="toggle-password" aria-label="Tampilkan kata sandi" class="absolute inset-y-0 right-0 px-3 flex items-center text-slate-400 hover:text-slate-700">
                <iconify-icon id="toggle-icon" icon="lucide:eye" width="16" height="16"></iconify-icon>
              </button>
            </div>
          </div>
          <button
            type="submit"
            <%= configured ? '' : 'disabled' %>
            class="w-full py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 disabled:bg-slate-300 disabled:cursor-not-allowed text-white font-semibold text-sm shadow-sm transition flex items-center justify-center gap-2"
          >
            <iconify-icon icon="lucide:log-in" width="16" height="16"></iconify-icon>
            <span>Masuk</span>
          </button>
        </form>
      </div>

      <p class="mt-5 text-center text-xs text-slate-500">
        Bukan admin? <a href="/" class="font-semibold text-brand-700 hover:underline">Kembali ke beranda</a>
      </p>
    </div>
  </main>

  <script>
    // Tombol tampilkan/sembunyikan kata sandi
    (function () {
      const input = document.getElementById('password');
      const btn = document.getElementById('toggle-password');
      const icon = document.getElementById('toggle-icon');
      btn.addEventListener('click', function () {
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        icon.setAttribute('icon', show ? 'lucide:eye-off' : 'lucide:eye');
        btn.setAttribute('aria-label', show ? 'Sembunyikan kata sandi' : 'Tampilkan kata sandi');
        input.focus();
      });
    })();
  </script>

<%- include('../partials/footer') %>
