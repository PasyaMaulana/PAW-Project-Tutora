<%- include('partials/head', { judul: judul }) %>

<%- include('partials/navbar') %>

  <main class="flex-1">
    <!-- Alert Notifikasi Flash Message -->
    <div class="max-w-6xl mx-auto px-6 pt-6">
      <%- include('partials/alert') %>
    </div>

    <!-- Hero Section -->
    <section class="max-w-6xl mx-auto px-6 pt-6 pb-16 grid lg:grid-cols-12 gap-10 items-center">
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-50 border border-brand-200 text-brand-800 text-xs font-semibold mb-5 shadow-sm">
          <iconify-icon icon="lucide:sparkles" class="text-amber-500" width="15" height="15"></iconify-icon>
          <span>Pembelajaran Adaptif Berbasis AI untuk Mahasiswa</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.15]">
          Pahami Materi Kuliah dengan <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-teal-600">Tutor Cerdas</span> yang Menyesuaikan Levelmu
        </h1>
        <p class="mt-5 text-slate-600 text-base sm:text-lg leading-relaxed max-w-xl">
          Bimbingan belajar mandiri di luar jam kelas. Pilih topik materi dan tentukan tingkat pemahaman Anda sendiri (<span class="font-medium text-slate-800">Pemula, Menengah, atau Lanjut</span>) untuk memperoleh penjelasan yang bertahap, analogi konkret, dan latihan berpikir aktif.
        </p>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href="#katalog" class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm shadow-sm transition hover:shadow-md flex items-center gap-2">
            <iconify-icon icon="lucide:layers" width="16" height="16"></iconify-icon>
            <span>Jelajahi Topik Belajar</span>
          </a>
          <a href="/assistant" class="px-6 py-3 rounded-xl bg-white border border-slate-300 hover:border-slate-400 text-slate-700 font-semibold text-sm transition flex items-center gap-2">
            <iconify-icon icon="lucide:sparkles" width="16" height="16" class="text-brand-600"></iconify-icon>
            <span>Mulai Belajar dengan AI Tutor</span>
          </a>
        </div>
      </div>

      <!-- Cara Belajar di Tutora -->
      <div class="lg:col-span-5">
        <div class="bg-white rounded-3xl border border-slate-200 shadow-xl shadow-slate-900/5 p-6">
          <div class="flex items-center gap-3 pb-4 mb-5 border-b border-slate-100">
            <div class="h-10 w-10 shrink-0 rounded-full bg-white border border-slate-200 flex items-center justify-center">
              <img src="/images/tutora-owl.png" alt="Tutora" class="h-6 w-auto">
            </div>
            <div>
              <p class="font-bold text-slate-900 text-sm">Cara Belajar di Tutora</p>
              <p class="text-xs text-slate-500">Tiga langkah menuju paham, bukan sekadar tahu jawaban</p>
            </div>
          </div>
          <ol class="space-y-4">
            <li class="flex gap-3">
              <span class="h-8 w-8 shrink-0 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center font-bold text-sm">1</span>
              <div>
                <p class="text-sm font-semibold text-slate-900">Pilih topik &amp; levelmu</p>
                <p class="text-xs text-slate-500 leading-relaxed">Pemula, Menengah, atau Lanjut. Penjelasan menyesuaikan kemampuanmu.</p>
              </div>
            </li>
            <li class="flex gap-3">
              <span class="h-8 w-8 shrink-0 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center font-bold text-sm">2</span>
              <div>
                <p class="text-sm font-semibold text-slate-900">Tanya AI Tutor kapan saja</p>
                <p class="text-xs text-slate-500 leading-relaxed">Minta penjelasan lebih sederhana atau contoh konkret saat materi terasa sulit.</p>
              </div>
            </li>
            <li class="flex gap-3">
              <span class="h-8 w-8 shrink-0 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center font-bold text-sm">3</span>
              <div>
                <p class="text-sm font-semibold text-slate-900">Uji pemahamanmu</p>
                <p class="text-xs text-slate-500 leading-relaxed">Jawab 3 pertanyaan singkat dan dapatkan feedback langsung.</p>
              </div>
            </li>
          </ol>
          <a href="/assistant" class="mt-6 w-full py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm shadow-sm transition flex items-center justify-center gap-2">
            <iconify-icon icon="lucide:sparkles" width="16" height="16"></iconify-icon>
            <span>Mulai Sekarang</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Fitur Pembelajaran Adaptif -->
    <section class="border-y border-slate-200/80 bg-white py-12">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center mb-8">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-600 flex items-center justify-center gap-1.5 mb-1.5">
            <iconify-icon icon="lucide:check-circle-2" width="14" height="14"></iconify-icon>
            Fitur Unggulan Tutora
          </span>
          <h2 class="text-2xl font-bold text-slate-900">Mendorong Mahasiswa Berpikir Aktif & Mandiri</h2>
        </div>
        <div class="grid md:grid-cols-4 gap-5">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-brand-300 transition">
            <div class="h-10 w-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center mb-3">
              <iconify-icon icon="lucide:sliders-horizontal" width="20" height="20"></iconify-icon>
            </div>
            <h3 class="font-bold text-slate-900 text-sm">Pilihan Tingkat Pemahaman</h3>
            <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">Bebas tentukan pemahaman Anda: Pemula, Menengah, atau Lanjut sesuai kesiapan.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-brand-300 transition">
            <div class="h-10 w-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center mb-3">
              <iconify-icon icon="lucide:message-square-code" width="20" height="20"></iconify-icon>
            </div>
            <h3 class="font-bold text-slate-900 text-sm">Tutor AI Adaptif</h3>
            <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">Tanya materi tanpa ragu di luar jam kuliah dengan respon cepat, ramah, dan terstruktur.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-brand-300 transition">
            <div class="h-10 w-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center mb-3">
              <iconify-icon icon="lucide:clipboard-check" width="20" height="20"></iconify-icon>
            </div>
            <h3 class="font-bold text-slate-900 text-sm">Mode Uji Pemahaman</h3>
            <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">Pertanyaan evaluatif singkat setelah sesi belajar untuk menguji konsep yang baru dipelajari.</p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 hover:border-brand-300 transition">
            <div class="h-10 w-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center mb-3">
              <iconify-icon icon="lucide:help-circle" width="20" height="20"></iconify-icon>
            </div>
            <h3 class="font-bold text-slate-900 text-sm">Bantuan & Contoh Konkret</h3>
            <p class="mt-1.5 text-xs text-slate-600 leading-relaxed">Tombol instan untuk meminta penjelasan yang lebih sederhana dan analogi contoh konkret.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Katalog Topik Pembelajaran -->
    <section id="katalog" class="max-w-6xl mx-auto px-6 py-16 scroll-mt-16 sm:scroll-mt-20">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 mb-1">
            <iconify-icon icon="lucide:book-open" width="14" height="14"></iconify-icon>
            <span>Katalog Topik</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Mau Belajar Apa Hari Ini?</h2>
          <p class="mt-1 text-slate-600 text-sm">
            Pilih topik dan tingkat pemahamanmu, lalu mulai bimbingan bersama AI Tutor.
          </p>
        </div>
        <div class="text-xs text-slate-600 font-semibold bg-white px-3 py-2 rounded-xl border border-slate-200 shadow-sm shrink-0 self-start sm:self-auto">
          <span class="font-bold text-brand-700"><%= (typeof topics !== 'undefined' ? topics.length : 0) %></span> topik tersedia
        </div>
      </div>

      <% if (typeof dbError !== 'undefined' && dbError) { %>
        <div class="mb-8 p-5 bg-amber-50 border border-amber-200 rounded-2xl text-amber-800 text-sm shadow-sm flex items-start gap-3">
          <iconify-icon icon="lucide:alert-triangle" width="18" height="18" class="mt-0.5 shrink-0 text-amber-600"></iconify-icon>
          <div>
            <p class="font-bold text-amber-900">Katalog sedang tidak dapat dimuat</p>
            <p class="mt-0.5 text-xs"><%= dbError %></p>
          </div>
        </div>
      <% } %>

      <% const displayTopics = (typeof topics !== 'undefined' ? topics : []); %>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <% if (displayTopics && displayTopics.length > 0) { %>
          <% displayTopics.forEach(function(item) { %>
            <div class="bg-white rounded-2xl border border-slate-200 hover:border-brand-500/60 p-6 flex flex-col justify-between shadow-sm hover:shadow-md transition group">
              <div>
                <!-- Header Card: Icon, Category & Actions -->
                <div class="flex items-center justify-between gap-2 mb-4">
                  <div class="h-10 w-10 rounded-xl bg-brand-50 text-brand-700 flex items-center justify-center group-hover:scale-110 transition">
                    <iconify-icon icon="<%= item.icon || 'lucide:book-open' %>" width="22" height="22"></iconify-icon>
                  </div>
                  <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700">
                    <%= item.kategori %>
                  </span>
                </div>

                <h3 class="font-bold text-slate-900 text-lg leading-snug group-hover:text-brand-700 transition">
                  <%= item.nama %>
                </h3>
                <p class="mt-2 text-sm text-slate-600 leading-relaxed line-clamp-3">
                  <%= item.deskripsi %>
                </p>
              </div>

              <!-- Bagian Bawah Card (Selalu rata bawah tidak peduli panjang deskripsi) -->
              <div class="mt-auto pt-5">
                <!-- Pilihan Tingkat Pemahaman Mandiri -->
                <%
                  const itemLevels = Array.isArray(item.levels) && item.levels.length > 0
                    ? item.levels
                    : (typeof item.levels === 'string' ? JSON.parse(item.levels || '["Pemula","Menengah","Lanjut"]') : ['Pemula', 'Menengah', 'Lanjut']);
                %>
                <div class="pt-4 border-t border-slate-100">
                  <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 block mb-2">Pilih Tingkat Pemahaman:</span>
                  <div class="flex gap-1.5" role="group">
                    <% itemLevels.forEach(function(lvl, idx) { %>
                      <label class="flex-1 cursor-pointer">
                        <input type="radio" name="level_<%= item.id %>" value="<%= lvl %>" class="peer sr-only" <%= idx === 0 ? 'checked' : '' %>>
                        <span class="block text-center text-xs py-1.5 px-1 rounded-lg border border-slate-200 font-medium text-slate-600 peer-checked:bg-brand-50 peer-checked:border-brand-500 peer-checked:text-brand-800 transition">
                          <%= lvl %>
                        </span>
                      </label>
                    <% }); %>
                  </div>
                </div>

                <!-- Tombol Aksi Sesi Belajar -->
                <div class="mt-4">
                  <button type="button" onclick="mulaiBimbingan(<%= item.id %>)" title="Mulai bimbingan bersama Tutora AI Tutor" class="w-full py-2.5 px-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-xs shadow-sm transition flex items-center justify-center gap-1.5">
                    <iconify-icon icon="lucide:play" width="14" height="14"></iconify-icon>
                    <span>Mulai Bimbingan</span>
                  </button>
                </div>
              </div>
            </div>
          <% }); %>
        <% } else if (typeof dbError === 'undefined' || !dbError) { %>
          <div class="col-span-full py-16 text-center text-slate-500 bg-white rounded-3xl border border-dashed border-slate-300 p-8">
            <div class="h-14 w-14 rounded-2xl bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3">
              <iconify-icon icon="lucide:book-open" width="28" height="28"></iconify-icon>
            </div>
            <h3 class="text-base font-bold text-slate-800">Belum ada topik di katalog</h3>
            <p class="text-xs text-slate-500 mt-1 max-w-sm mx-auto">Topik pembelajaran akan segera tersedia. Silakan kembali lagi nanti.</p>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
              <div class="mt-4 flex items-center justify-center gap-3">
                <a href="/admin/topics/create" class="px-4 py-2 rounded-xl bg-brand-600 text-white font-semibold text-xs shadow-sm hover:bg-brand-700 transition">
                  + Tambah Topik Pertama
                </a>
              </div>
            <% } %>
          </div>
        <% } %>
      </div>
    </section>
  </main>

  <script>
    // Membuka AI Tutor dengan topik & level yang dipilih pada kartu
    function mulaiBimbingan(id) {
      const pilihan = document.querySelector('input[name="level_' + id + '"]:checked');
      const level = pilihan ? pilihan.value : 'Pemula';
      window.location.href = '/assistant?topic=' + id + '&level=' + encodeURIComponent(level);
    }
  </script>

  <script src="/js/nav-spy.js"></script>
<%- include('partials/footer') %>
