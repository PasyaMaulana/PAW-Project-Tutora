<%
  // Navbar bersama untuk semua halaman. activePage: 'home' | 'assistant' | 'history' | 'admin'
  const halamanAktif = typeof activePage !== 'undefined' ? activePage : '';
  const adminMasuk = typeof isAdmin !== 'undefined' && isAdmin;
  const menu = [
    { id: 'home', href: '/', icon: 'lucide:home', label: 'Beranda' },
    { id: 'katalog', href: '/#katalog', icon: 'lucide:book-open', label: 'Katalog' },
    { id: 'assistant', href: '/assistant', icon: 'lucide:sparkles', label: 'AI Tutor' },
    { id: 'history', href: '/riwayat', icon: 'lucide:history', label: 'Riwayat' },
  ];
%>
  <header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 sm:h-20 flex items-center justify-between gap-3">
      <a href="/" class="flex items-center group py-2 shrink-0" aria-label="Tutora - Beranda">
        <img src="/images/tutora-logo.png" alt="Tutora Logo" class="h-9 sm:h-12 w-auto object-contain transition-transform duration-200 group-hover:scale-105">
      </a>

      <nav class="flex items-center gap-1 sm:gap-2 text-sm font-medium" aria-label="Navigasi utama">
        <% menu.forEach(function(m) { const aktif = halamanAktif === m.id; %>
          <a
            href="<%= m.href %>"
            data-nav="<%= m.id %>"
            <%- aktif ? 'aria-current="page"' : '' %>
            title="<%= m.label %>"
            class="px-2.5 sm:px-3 py-2 rounded-lg flex items-center gap-1.5 transition <%= aktif ? 'bg-brand-50 text-brand-700 font-semibold' : 'text-slate-600 hover:text-brand-700 hover:bg-slate-50' %>"
          >
            <iconify-icon icon="<%= m.icon %>" width="16" height="16"></iconify-icon>
            <span class="hidden md:inline"><%= m.label %></span>
          </a>
        <% }); %>

        <% if (adminMasuk) { %>
          <!-- Menu khusus admin (hanya tampil setelah login admin) -->
          <a
            href="/admin/topics"
            <%- halamanAktif === 'admin' ? 'aria-current="page"' : '' %>
            title="Kelola Topik"
            class="ml-1 px-3 py-2 rounded-xl text-xs font-semibold transition flex items-center gap-1.5 <%= halamanAktif === 'admin' ? 'bg-brand-600 text-white shadow-sm' : 'bg-brand-50 text-brand-700 hover:bg-brand-100' %>"
          >
            <iconify-icon icon="lucide:shield-check" width="16" height="16"></iconify-icon>
            <span class="hidden lg:inline">Kelola Topik</span>
          </a>
          <form action="/admin/logout" method="POST">
            <button type="submit" title="Keluar dari admin" class="px-2.5 py-2 rounded-lg text-slate-500 hover:text-rose-600 hover:bg-rose-50 transition flex items-center gap-1.5">
              <iconify-icon icon="lucide:log-out" width="16" height="16"></iconify-icon>
              <span class="hidden lg:inline text-xs font-semibold">Keluar</span>
            </button>
          </form>
        <% } %>
      </nav>
    </div>
  </header>
