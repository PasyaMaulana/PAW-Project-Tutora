  <!-- Modal Konfirmasi Bersama (pengganti confirm() bawaan browser), dikendalikan oleh /js/modal.js -->
  <div id="confirm-modal" class="hidden fixed inset-0 z-[60] flex items-end sm:items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-desc">
    <div data-modal-backdrop class="absolute inset-0 bg-slate-900/40 backdrop-blur-sm opacity-0 transition-opacity duration-200"></div>

    <div data-modal-panel class="relative w-full max-w-sm rounded-2xl bg-white shadow-2xl shadow-slate-900/20 border border-slate-200 p-6 opacity-0 translate-y-4 sm:translate-y-0 sm:scale-95 transition duration-200">
      <div class="flex items-start gap-4">
        <div data-modal-icon-wrap class="h-11 w-11 shrink-0 rounded-full bg-amber-50 text-amber-600 ring-4 ring-amber-50/60 flex items-center justify-center">
          <iconify-icon id="confirm-icon" icon="lucide:help-circle" width="20" height="20"></iconify-icon>
        </div>
        <div class="min-w-0 pt-0.5">
          <h3 id="confirm-title" class="text-base font-bold text-slate-900">Konfirmasi</h3>
          <p id="confirm-desc" class="mt-1.5 text-sm text-slate-500 leading-relaxed"></p>
        </div>
      </div>
      <div class="mt-6 flex flex-col-reverse sm:flex-row sm:justify-end gap-2">
        <button type="button" data-modal-cancel class="px-4 py-2.5 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-sm font-semibold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-slate-400/40">
          Batal
        </button>
        <button type="button" data-modal-confirm class="px-4 py-2.5 rounded-xl text-white text-sm font-semibold shadow-sm transition focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2">
          Ya, Lanjutkan
        </button>
      </div>
    </div>
  </div>
  <script src="/js/modal.js"></script>
