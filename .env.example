# Konfigurasi Server
PORT=3000

# Konfigurasi Database PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password_kamu
DB_NAME=tutora_db

# Konfigurasi Google Gemini (AI Tutor)
GEMINI_API_KEY=api_key_gemini_kamu
GEMINI_MODEL=gemini-2.5-flash
# Model cadangan jika model utama sibuk / timeout / kuota habis
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Batas waktu per percobaan model (ms)
GEMINI_TIMEOUT_MS=15000

# Rate limiter AI Tutor: maksimal permintaan per IP per menit
CHAT_RATE_LIMIT_PER_MINUTE=10

# Area Admin (Kelola Katalog Topik) - satu kata sandi bersama, tanpa akun
ADMIN_PASSWORD=ganti_dengan_kata_sandi_admin_yang_kuat
# Kunci rahasia untuk menandatangani cookie sesi admin (string acak panjang)
SESSION_SECRET=ganti_dengan_string_acak_panjang
